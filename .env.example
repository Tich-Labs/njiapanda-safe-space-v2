# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# Google AI
GOOGLE_AI_STUDIO_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash-live-001
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Lovable AI Gateway (for hadithi-stream, ai-brief, transcribe-audio, moderate-story)
LOVABLE_API_KEY=your_lovable_api_key

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenFN
OPENFN_WEBHOOK_URL=https://app.openfn.org/webhooks/...

# Resend (optional - for feedback notifications)
RESEND_API_KEY=re_...

# Supabase service role (edge functions only - never expose to frontend)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cloud Run (optional - only if deploying agents to GCP)
SAUTI_ADK_URL=https://sauti-agent-xxxx-uc.a.run.app
SAUTI_ADK_TOKEN=your_bearer_token