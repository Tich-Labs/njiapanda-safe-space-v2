# Google AI (direct from frontend - no backend needed)
VITE_GOOGLE_AI_STUDIO_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash-live-001
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenFN
OPENFN_WEBHOOK_URL=https://app.openfn.org/webhooks/...

# Resend (optional - for feedback notifications)
RESEND_API_KEY=re_...

# Cloud Run (optional - only if deploying agents to GCP)
SAUTI_ADK_URL=https://sauti-agent-xxxx-uc.a.run.app
SAUTI_ADK_TOKEN=your_bearer_token

# GCP Cloud Functions (for hadithi-stream)
VITE_GCP_FUNCTION_URL=https://hadithi-stream-xxxx-uc.a.run.app
GEMINI_API_KEY=AIza...

# MongoDB (for sourced survivor story storage)
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/njiapanda?retryWrites=true&w=majority
MONGODB_DB_NAME=njiapanda
MONGODB_COLLECTION_STORIES=sourced_articles

# Article Sourcing Agent (Cloud Run)
VITE_ARTICLE_SOURCING_URL=https://article-sourcing-xxxx-uc.a.run.app
