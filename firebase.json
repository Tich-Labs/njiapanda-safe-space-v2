{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "firebase/functions/hadithi-stream",
      "codebase": "hadithi-stream",
      "ignore": ["node_modules", "firebase.json"]
    },
    {
      "source": "firebase/functions/sauti-gateway",
      "codebase": "sauti-gateway",
      "ignore": ["node_modules", "firebase.json"]
    },
    {
      "source": "firebase/functions/sourced-articles",
      "codebase": "sourced-articles",
      "ignore": ["node_modules", "firebase.json"]
    }
  ]
}